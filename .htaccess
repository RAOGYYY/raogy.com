# Enable URL Rewriting
RewriteEngine On

# Short alias: the BeatFlak policy file is privacy-policy.html (the game build links
# to that exact name), so /beatflak/privacy has no privacy.html to fall back on.
# Must sit above the root rule, which would otherwise rewrite it to privacy.html.
# Mirrors the /beatflak/privacy rewrite in vercel.json.
RewriteRule ^beatflak/privacy/?$ beatflak/privacy-policy.html [NC,L]

# Remove .html extension for root files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Remove .html extension for subdirectories
#
# This list is hardcoded, so every new app directory has to be added to it AND to
# the redirect rule further down. golden-sparrow was live for a week before anyone
# noticed it was missing from both.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(screenscribe|paaniboss|rewardnest|snapscribe|krexo|isellback|golden-sparrow|tinbrook|beatflak)/([^\.]+)$ $1/$2.html [NC,L]

# Redirect .html to clean URLs for root files
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP
RewriteRule ^([^.]+)\.html$ /$1 [R=301,L]

# Redirect .html to clean URLs for subdirectories
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(screenscribe|paaniboss|rewardnest|snapscribe|krexo|isellback|golden-sparrow|tinbrook|beatflak)/([^.]+)\.html\ HTTP
RewriteRule ^(screenscribe|paaniboss|rewardnest|snapscribe|krexo|isellback|golden-sparrow|tinbrook|beatflak)/([^.]+)\.html$ /$1/$2 [R=301,L]

# Force HTTPS (uncomment when you have SSL)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www or non-www (choose one)
# Force non-www:
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Redirect index.html to root
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP
RewriteRule ^index\.html$ / [R=301,L]

# Set default page
DirectoryIndex index.html

# Compress text files
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
